# ASK YALLTOO - Environment Variables
# Copy this file to .env.local and fill in the values

# AI Provider (enables AI-powered answer synthesis)
# When set, answers are generated using the AI model with strict grounding rules.
# When not set, the system falls back to document-extraction-based answers.
# ANTHROPIC_API_KEY=your-api-key-here

# Application
NEXT_PUBLIC_SITE_URL=https://ask.yalltoo.com
